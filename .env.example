# Base mainnet RPC (chainId 8453). Required — never hardcode this in source.
BASE_RPC_URL=https://mainnet.base.org

# Optional: URL used by `pnpm test` to fork Base mainnet with Anvil.
# Defaults to BASE_RPC_URL when unset.
FORK_RPC_URL=

# Optional: anvil endpoint the fork tests talk to.
ANVIL_RPC_URL=http://127.0.0.1:8545

# Optional: agent signer for permissionless claims ONLY.
# Funds always route to the owner; this key just pays gas.
# Leave unset to run in build-only mode (no tx is ever sent).
AGENT_PRIVATE_KEY=

# Optional: enables the LLM brief. Without it the deterministic brief is used.
ANTHROPIC_API_KEY=
