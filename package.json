{
  "name": "@orionscope/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Non-custodial agent that finds and reclaims unclaimed on-chain value on Base.",
  "bin": {
    "orionscope": "./dist/cli.js",
    "orionscope-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "mcp": "tsx --env-file-if-exists=.env src/mcp/server.ts",
    "test:mcp": "vitest run test/unit/mcp.test.ts test/unit/mcpStdio.test.ts test/unit/registry.test.ts",
    "test:unit": "vitest run test/unit",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "serve": "tsx --env-file-if-exists=.env src/server/index.ts",
    "test:api": "vitest run test/unit/server.test.ts",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.13.3",
    "viem": "^2.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CLAUDE.md",
    "CLANKER.md"
  ]
}
